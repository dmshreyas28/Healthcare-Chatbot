# LLM Configuration for Docker
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://duty-collectors-june-synthetic.trycloudflare.com
OLLAMA_MODEL=llama2:7b

# RAG Configuration
ENABLE_RAG=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=/app/chroma_db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Notes:
# - OLLAMA_BASE_URL: Update with your current Colab tunnel URL
# - If Colab restarts, get the new URL from the notebook output
# - To use: copy this to .env before running docker-compose up
